# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# Resend Email Service
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_EMAIL=sahil@rkgproperties.in
# Use onboarding@resend.dev only for testing; to send confirmation emails to submitters, verify your domain in Resend and set e.g.:
# RESEND_FROM_EMAIL=noreply@rkgproperties.in
RESEND_FROM_EMAIL=onboarding@resend.dev

# YouTube Data API v3 — list latest uploads for the channel (homepage embeds)
# Google Cloud: enable "YouTube Data API v3", create an API key.
# Vercel runs this on the SERVER: do NOT use "HTTP referrers" application restriction (requests
# have no browser referrer). Use "API restriction" = YouTube Data API v3 only, and either "None" for
# application restriction or IP (serverless IPs vary, so "None" + API restriction is typical).
# Vercel: add YOUTUBE_API_KEY for Production (and Preview if needed), then redeploy.
YOUTUBE_API_KEY=your_youtube_data_api_key
# Optional; defaults to RKG channel UCv_BbICqcxwpchi_hImuiXg
# YOUTUBE_CHANNEL_ID=UCv_BbICqcxwpchi_hImuiXg

# Node Environment
NODE_ENV=production
